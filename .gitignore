# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Standalone - don't ignore our standalone files
# (but ignore generated files within standalone)
!standalone/
standalone/lib/
standalone/var/
standalone/build/
standalone/bin/

# Windows
AppData/
Local Settings/
*.lnk

# FreeNT specific (keep these for tracking)
!install-log.json
!freent.json
!gnu-toolchain-config.json
!gnuless-toolchain-config.json

.system/